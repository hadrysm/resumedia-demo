---
import type { Media } from '@resumedia-demo/shared/payload-types'

import { imageSource } from '../lib/cms'

type Props = { media: Media | number | null | undefined; sizes: string; class?: string; eager?: boolean }
const { media, sizes, class: className, eager = false } = Astro.props
const image = imageSource(media)
---

{
  image && (
    <img
      src={image.src}
      srcset={image.srcset || undefined}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={image.alt}
      class={className}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  )
}
