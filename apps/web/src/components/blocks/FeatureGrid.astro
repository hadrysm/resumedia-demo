---
import Icon from '../Icon.astro'
import SectionHeading from './SectionHeading.astro'
import type { BlockProps } from './types'

type Props = BlockProps<'featureGrid'>
const { block } = Astro.props
---

<section class="container-page py-20 sm:py-24">
  <SectionHeading heading={block.heading} intro={block.intro} />
  <ul class="mt-14 grid gap-6 md:grid-cols-3">
    {
      (block.features ?? []).map((feature) => (
        <li class="relative rounded-3xl bg-slate-50 p-8 ring-1 ring-slate-200/70">
          <span class="grid size-12 place-items-center rounded-2xl bg-white text-brand shadow-sm ring-1 ring-slate-200">
            <Icon name={feature.icon} class="size-6" />
          </span>
          <h3 class="mt-6 text-lg font-bold text-ink">{feature.title}</h3>
          {feature.description && <p class="mt-2 leading-7 text-slate-600">{feature.description}</p>}
        </li>
      ))
    }
  </ul>
</section>
