---
import SectionHeading from './SectionHeading.astro'
import type { BlockProps } from './types'

type Props = BlockProps<'faq'>
const { block } = Astro.props
const items = block.items ?? []
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}
---

<section class="container-page py-20 sm:py-24">
  <SectionHeading heading={block.heading} />
  <div class="mx-auto mt-12 max-w-3xl divide-y divide-slate-200 rounded-3xl bg-white ring-1 ring-slate-200">
    {
      items.map((item) => (
        <details class="group px-6 py-5 sm:px-8">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
            {item.question}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand/10 text-brand transition group-open:rotate-45">
              <svg viewBox="0 0 20 20" class="size-4" fill="currentColor" aria-hidden="true">
                <path d="M10 4a.75.75 0 0 1 .75.75v4.5h4.5a.75.75 0 0 1 0 1.5h-4.5v4.5a.75.75 0 0 1-1.5 0v-4.5h-4.5a.75.75 0 0 1 0-1.5h4.5v-4.5A.75.75 0 0 1 10 4z" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 pr-12 leading-7 text-slate-600">{item.answer}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</section>
