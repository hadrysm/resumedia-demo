---
import Icon, { type IconName } from '../Icon.astro'
import Img from '../Img.astro'
import type { BlockProps } from './types'

type Props = BlockProps<'hero'>
const { block, ctx } = Astro.props
const style = ctx.tenant.theme.heroStyle
const highlights = block.highlights ?? []
const hasImage = Boolean(block.image)
const toolIcons: IconName[] = ['template', 'letter', 'search', 'chat']
---

{
  style === 'toolbox' && (
    <section class="relative isolate overflow-hidden bg-linear-to-b from-brand/10 via-white to-white">
      <div class="absolute -top-24 -right-24 -z-10 size-[28rem] rounded-full bg-accent/20 blur-3xl" />
      <div class="absolute top-40 -left-32 -z-10 size-80 rounded-full bg-brand/15 blur-3xl" />
      <div
        class:list={[
          'container-page grid items-center gap-12 pt-14 pb-12 sm:pt-20',
          hasImage && 'lg:grid-cols-[1.1fr_1fr]',
        ]}
      >
        <div class:list={[!hasImage && 'mx-auto w-full max-w-3xl']}>
          {block.eyebrow && (
            <p class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-brand shadow-sm ring-1 ring-brand/15">
              <span class="size-2 rounded-full bg-accent" />
              {block.eyebrow}
            </p>
          )}
          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl">
            {block.heading}
          </h1>
          {block.subheading && <p class="mt-6 max-w-xl text-lg leading-8 text-pretty text-slate-600">{block.subheading}</p>}
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a
              href={ctx.tenant.appUrl}
              class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand/30 transition hover:-translate-y-0.5 hover:brightness-110"
            >
              {block.ctaLabel}
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
        </div>
        {hasImage && (
          <div class="relative">
            <div class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-linear-to-tr from-brand/25 to-accent/25 blur-2xl" />
            <Img
              media={block.image}
              sizes="(min-width: 1024px) 560px, 100vw"
              eager
              class="w-full rounded-[2rem] shadow-2xl ring-1 shadow-slate-900/15 ring-slate-900/5"
            />
          </div>
        )}
      </div>
      {highlights.length > 0 && (
        <div class="container-page pb-16">
          <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {highlights.map((item, i) => (
              <li class="group rounded-2xl bg-white p-4 shadow-sm sm:p-5 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg hover:ring-brand/30">
                <span class="grid size-11 place-items-center rounded-xl bg-brand/10 text-brand transition group-hover:bg-brand group-hover:text-white">
                  <Icon name={toolIcons[i % toolIcons.length]} class="size-5" />
                </span>
                <p class="mt-4 font-bold text-ink">{item.label}</p>
                {item.description && <p class="mt-1 text-sm text-slate-500">{item.description}</p>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}

{
  style === 'split' && (
    <section class="relative isolate overflow-hidden">
      <div class="absolute top-0 -right-48 -z-10 size-[40rem] rounded-full bg-accent/15 blur-3xl" />
      <div class="absolute -bottom-40 left-1/3 -z-10 size-[30rem] rounded-full bg-brand/10 blur-3xl" />
      <div
        class:list={[
          'container-page grid items-center gap-14 py-16 sm:py-24',
          hasImage && 'lg:grid-cols-[1.05fr_1fr]',
        ]}
      >
        <div class:list={[!hasImage && 'mx-auto w-full max-w-3xl']}>
          {block.eyebrow && <p class="text-sm font-bold tracking-[0.18em] text-brand uppercase">{block.eyebrow}</p>}
          <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-balance text-ink sm:text-5xl lg:text-[3.6rem] lg:leading-[1.05]">
            {block.heading}
          </h1>
          {block.subheading && <p class="mt-6 max-w-xl text-lg leading-8 text-pretty text-slate-600">{block.subheading}</p>}
          {highlights.length > 0 && (
            <ul class="mt-8 space-y-3">
              {highlights.map((item) => (
                <li class="flex items-center gap-3 font-medium text-slate-700">
                  <span class="grid size-6 place-items-center rounded-full bg-accent text-white">
                    <Icon name="check" class="size-3.5" />
                  </span>
                  {item.label}
                </li>
              ))}
            </ul>
          )}
          <a
            href={ctx.tenant.appUrl}
            class="mt-10 inline-flex items-center gap-2 rounded-xl bg-ink px-7 py-4 text-base font-semibold text-white shadow-xl shadow-slate-900/20 transition hover:-translate-y-0.5 hover:bg-brand"
          >
            {block.ctaLabel}
            <Icon name="arrow" class="size-4" />
          </a>
        </div>
        {hasImage && (
          <div class="relative mx-auto w-full max-w-xl">
            <div class="absolute inset-6 -z-10 rotate-6 rounded-[2.5rem] bg-brand" />
            <Img
              media={block.image}
              sizes="(min-width: 1024px) 560px, 100vw"
              eager
              class="w-full -rotate-2 rounded-[2rem] shadow-2xl shadow-slate-900/25"
            />
          </div>
        )}
      </div>
    </section>
  )
}

{
  style === 'centered' && (
    <section class="relative isolate">
      <div class:list={['relative overflow-hidden bg-brand text-white', hasImage ? 'pb-48 sm:pb-64' : 'pb-20']}>
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.18),transparent_45%),radial-gradient(circle_at_85%_60%,var(--brand-accent),transparent_40%)] opacity-70" />
        <div class="mx-auto max-w-3xl px-5 pt-16 text-center sm:px-8 sm:pt-24">
          {block.eyebrow && (
            <p class="inline-flex rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold ring-1 ring-white/25 backdrop-blur">
              {block.eyebrow}
            </p>
          )}
          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl">{block.heading}</h1>
          {block.subheading && (
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-pretty text-white/85">{block.subheading}</p>
          )}
          <a
            href={ctx.tenant.appUrl}
            class="mt-10 inline-flex items-center gap-2 rounded-full bg-white px-8 py-4 text-base font-bold text-brand shadow-xl shadow-black/15 transition hover:-translate-y-0.5"
          >
            {block.ctaLabel}
            <Icon name="arrow" class="size-4" />
          </a>
          {highlights.length > 0 && (
            <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-white/90">
              {highlights.map((item) => (
                <li class="flex items-center gap-2">
                  <Icon name="check" class="size-4" />
                  {item.label}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
      {hasImage && (
        <div class="container-page relative -mt-40 sm:-mt-52">
          <Img
            media={block.image}
            sizes="(min-width: 1024px) 896px, 100vw"
            eager
            class="mx-auto w-full max-w-4xl rounded-[2rem] shadow-2xl ring-8 shadow-slate-900/20 ring-white"
          />
        </div>
      )}
    </section>
  )
}
