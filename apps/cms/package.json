{
  "name": "cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "build": "NODE_OPTIONS='--no-deprecation --max-old-space-size=8000' next build",
    "build:vercel": "pnpm run migrate && pnpm run build",
    "start": "NODE_OPTIONS=--no-deprecation next start --port 3000",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-mcp": "3.92.0",
    "@payloadcms/plugin-multi-tenant": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@resumedia-demo/shared": "workspace:*",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
