# Local values match docker-compose.yml. See the README for production values.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/resumedia
PAYLOAD_SECRET=change-me-to-a-long-random-string
CMS_URL=http://localhost:3000
WEB_URL=http://localhost:4321
PREVIEW_SECRET=change-me-too

# Cloudflare R2 (S3 API). Locally MinIO stands in. Leave R2_BUCKET empty to store files on local disk.
R2_ENDPOINT=http://127.0.0.1:9010
R2_BUCKET=resumedia-media
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PUBLIC_URL=http://127.0.0.1:9010/resumedia-media

# Seed only
SEED_PASSWORD=demo-password-123
MCP_API_KEY=local-mcp-key-change-me
# Optional. Adds a per-brand production hostname, for example {slug}-resumedia-demo.vercel.app.
SEED_DOMAIN_TEMPLATE=
